{{ 'neoric-trust-badges.css' | asset_url | stylesheet_tag }}

<div class="neoric-trust-badges">

  {% for i in (1..3) %}

    <div class="neoric-trust-badge">

      <img
        src="{{ 'badge.png' | file_url }}"   
        width="auto"     
        height="auto"
        alt="Trust Badge"
        loading="lazy"
      >

      <div class="neoric-trust-badge__text">
        <p class="neoric-trust-badge__title">
          {{ title }}
        </p>

        <p class="neoric-trust-badge__desc">
          {{ text }}
        </p>
      </div>

    </div>

  {% endfor %}

</div>