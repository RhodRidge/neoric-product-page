{{ 'neoric-gallery.css' | asset_url | stylesheet_tag }}

<div class="neoric-gallery">
    <div class="neoric-gallery__thumbs"> 
        {% for media in product.media %} 
            <button 
                class="neoric-gallery__thumb" 
                data-index="{{ forloop.index0 }}" 
            > 
                <img 
                    src="{{ media.preview_image | image_url: width: 100 }}" 
                    width="100" 
                    height=auto 
                    alt="{{ media.alt | escape }}" 
                    loading="lazy" 
                    decoding="async" 
                > 
            </button> 
        {% endfor %} 
    </div>
    <div class="neoric-gallery__main">
        <div class="neoric-gallery__track">
            {% for media in product.media %}
                <div class="neoric-gallery__slide {% if forloop.first %}is-active{% endif %}">
                    <img
                        src="{{ media.preview_image | image_url: width: 480 }}"
                        width="480"
                        height="auto"
                        alt="{{ media.alt | escape }}"
                        loading="lazy"
                        decoding="async"
                    >
                </div>
            {% endfor %}
        </div>
            <div class="neoric-gallery__arrows">
                <button 
                    class="neoric-gallery__arrow neoric-gallery__arrow--prev" 
                    aria-label="Previous image"
                >
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                        <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>

                <button 
                    class="neoric-gallery__arrow neoric-gallery__arrow--next" 
                    aria-label="Next image"
                >
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                        <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </div>
    </div>

    <div class="neoric-gallery__dots">
        {% for media in product.media %}
            <span class="dot"></span>
        {% endfor %}
    </div>
</div>