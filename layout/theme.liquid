<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {{ content_for_header }}

    {{ 'all.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'neoric-gallery.css' | asset_url | stylesheet_tag }}
    {{ 'neoric-info-card.css' | asset_url | stylesheet_tag }}
    {{ 'footer.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'neoric-gallery.js' | asset_url }}" defer></script>

  </head>
  <body>
    {% section 'header' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
      {% section 'neoric-product' %}
    </main>

    {% section 'footer' %}
  </body>
</html>