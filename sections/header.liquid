{% schema %}
{
  "name": "Neoric Header",
  "settings": [],
  "presets": [{ "name": "Neoric Header" }]
}
{% endschema %}

<header class="neoric-header">
  <div class="desktop-header">
    <img src="{{ 'header-desktop.png' | file_img_url: 'master' }}" width="100%" height="auto" alt="Header Desktop">
  </div>
  <div class="mobile-header">
    <img src="{{ 'header-mobile.png' | file_img_url: 'master' }}" width="100%" height="auto" alt="Header Desktop">
  </div>
</header>

<style>
  .neoric-header { width: 100%; display: block; }
  .neoric-header img { width: 100%; height: auto; display: block; }

  .mobile-header { display: none; }

  @media (max-width: 768px) {
    .desktop-header { display: none; }
    .mobile-header { display: block; }
  }
</style>