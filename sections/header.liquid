{{ 'header.css' | asset_url | stylesheet_tag }}

<header class="neoric-header">
	<picture class="neoric-header__image">
		{% if section.settings.hero_mobile != blank %}
		<source media="(max-width: 768px)" srcset="{{ section.settings.hero_mobile | image_url: width: 900 }}">
		{% endif %}

		{% if section.settings.hero_desktop != blank %}
		<img
			src="{{ section.settings.hero_desktop | image_url: width: 2000 }}"
			alt="{{ section.settings.hero_alt }}"
			width="2000"
			height="auto"
			loading="eager"
			fetchpriority="high">
		{% endif %}
	</picture>
</header>