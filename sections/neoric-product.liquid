{% assign product = all_products['neoric-neon'] %}
<section class="neoric-product"> 
    <div class="neoric-product__container">
        <div class="neoric-product__gallery">
            {% render 'neoric-gallery', product: product %}
        </div>
        <div class="neoric-product__info">
            {% render 'neoric-info-card',
                product: product,
                subtitle: section.settings.subtitle,
                stock_text: section.settings.stock_text,
                button_text: section.settings.button_text
            %}
        </div>
    </div>
</section>

