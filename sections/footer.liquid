{{ 'footer.css' | asset_url | stylesheet_tag }}

<footer>
  <div class="neoric-trust-badges">
    {% for i in (1..3) %}
      <div class="neoric-trust-badge">
        <img
          src="{{ 'badge.png' | file_url }}"
          width="auto"
          height="auto"
          alt="Trust Badge"
          loading="lazy">
        <div class="neoric-trust-badge__text">
          <span class="neoric-trust-badge__title">
            {{ 'features.quality_badge' | t | strip_html }}
          </span>

          <span class="neoric-trust-badge__desc">
            {{ 'features.quality_description' | t | strip_html }}
          </span>
        </div>
      </div>
    {% endfor %}
  </div>
</footer>